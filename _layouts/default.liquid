<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ page.title | default: site.title }}</title>
    <meta name="description" content="{{ page.description | default: site.description | escape }}">
    <meta property="og:description" content="{{ page.description | default: site.description | escape }}">
    <meta name="twitter:description" content="{{ page.description | default: site.description | escape }}">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <link rel="icon" href="{{ '/favicon.ico' | relative_url }}" type="image/x-icon">
    <script>
      (function () {
        document.documentElement.classList.add('js');
        try {
          var stored = localStorage.getItem('theme');
          var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var theme = (stored === 'dark' || stored === 'light')
            ? stored
            : (prefersDark ? 'dark' : 'light');
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.setAttribute('data-theme', 'dark');
          }
        }
      })();
    </script>

    <style>
      :root {
        color-scheme: light;
        --accent: #6d28d9;
        --accent-contrast: #ffffff;
        --text-main: #111827;
        --text-muted: #4b5563;
        --bg-color: #ffffff;
        --border-color: #d1d5db;
        --font-sans: monospace, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
        --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      }

      @media (prefers-color-scheme: dark) {
        :root:not([data-theme="light"]) {
          color-scheme: dark;
          --accent: #a78bfa;
          --accent-contrast: #111827;
          --text-main: #f9fafb;
          --text-muted: #cbd5e1;
          --bg-color: #2e3440;
          --border-color: #334155;
        }
      }

      :root[data-theme="dark"] {
        color-scheme: dark;
        --accent: #a78bfa;
        --accent-contrast: #111827;
        --text-main: #f9fafb;
        --text-muted: #cbd5e1;
        --bg-color: #2e3440;
        --border-color: #334155;
      }

      * { box-sizing: border-box; }

      html {
        scroll-behavior: smooth;
        -webkit-text-size-adjust: 100%;
      }

      body {
        max-width: 850px;
        margin: 0 auto;
        padding: 0 1.5rem;
        background: var(--bg-color);
        color: var(--text-main);
        font-family: var(--font-sans);
        line-height: 1.6;
        -webkit-font-smoothing: antialiased;
        text-rendering: optimizeLegibility;
        overflow-wrap: break-word;
        transition: background-color 0.2s ease, color 0.2s ease;
      }

      button {
        font: inherit;
      }

      header.site-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        padding: 4rem 0 1rem 0;
      }

      .header-text {
        min-width: 0;
      }

      .logo-link {
        text-decoration: none;
        color: var(--text-main);
        transition: opacity 0.2s;
      }

      .logo-link:hover { opacity: 0.7; }

      header h1 {
        font-size: 2.5rem;
        font-weight: 800;
        margin: 0;
        letter-spacing: -0.02em;
        line-height: 1.2;
      }

      .tagline {
        font-size: 1.1rem;
        color: var(--text-muted);
        margin: 0.5rem 0 0 0;
      }

      .theme-toggle {
        display: none;
        flex-shrink: 0;
        background: transparent;
        border: 1px solid var(--border-color);
        color: var(--text-main);
        border-radius: 999px;
        padding: 0.5rem 0.8rem;
        font-size: 0.95rem;
        line-height: 1;
        cursor: pointer;
        transition: border-color 0.2s, color 0.2s, background-color 0.2s;
      }

      .js .theme-toggle {
        display: inline-flex;
      }

      .theme-toggle:hover {
        border-color: var(--accent);
        color: var(--accent);
      }

      nav.main-nav {
        margin: 2rem 0 4rem 0;
        display: flex;
        gap: 2rem;
        border-bottom: 1px solid var(--border-color);
        padding-bottom: 1rem;
        overflow-x: auto;
      }

      nav.main-nav a {
        text-decoration: none;
        color: var(--text-main);
        font-weight: 600;
        font-size: 1rem;
        padding: 0.5rem 0;
        white-space: nowrap;
      }

      nav.main-nav a:hover { color: var(--accent); }

      nav.main-nav a[aria-current="page"] {
        color: var(--accent);
      }

      main {
        font-size: 1rem;
        max-width: 70ch;
      }

      h2, h3, h4 {
        color: var(--text-main);
        margin-top: 2.5rem;
        font-weight: 800;
        line-height: 1.8;
      }

      a {
        color: var(--accent);
      }

      main a {
        text-decoration: underline;
        text-underline-offset: 0.15em;
        text-decoration-thickness: 0.08em;
      }

      main a:hover {
        text-decoration-thickness: 0.14em;
      }

      .logo-link,
      nav.main-nav a {
        text-decoration: none;
      }

      :focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
      }

      .posts-list { list-style: none; padding: 0; }

      .post-item {
        display: flex;
        gap: 3rem;
        margin-bottom: 3.5rem;
      }

      .post-date .day {
        font-size: 3rem;
        font-weight: 800;
        display: block;
        line-height: 0.9;
        color: var(--text-muted);
      }

      .post-date .month-year {
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        color: var(--text-muted);
        display: block;
        margin-top: 0.2rem;
      }

      .post-info h3 {
        margin: 0;
        font-size: 1.5rem;
        line-height: 1.2;
      }

      .post-info p {
        margin: 0.5rem 0 0 0;
        color: var(--text-muted);
        font-size: 1rem;
      }

      img {
        display: block;
        width: 75%;
        height: auto;
        max-width: 100%;
        margin: 1.5rem auto;
      }

      code, pre {
        font-family: var(--font-mono);
        background-color: var(--code-bg);
        color: var(--code-text);
        border: 1px solid var(--border-color);
        border-radius: 4px;
      }

      code {
        padding: 0.2em 0.4em;
        overflow-wrap: break-word;
      }

      pre {
        padding: 1rem;
        max-width: 100%;
        overflow-x: auto;
        tab-size: 2;
      }

      pre code {
        padding: 0;
        background: transparent;
        border: 0;
        white-space: pre;
      }

      footer.site-footer {
        margin: 6rem 0 3rem 0;
        color: var(--text-muted);
        font-size: 0.9rem;
        border-top: 1px solid var(--border-color);
        padding-top: 1.5rem;
      }

      @media (max-width: 600px) {
        body {
          padding: 0 1rem;
        }

        header.site-header {
          flex-direction: column;
        }

        header h1 {
          font-size: 1.8rem;
        }

        nav.main-nav {
          gap: 1rem;
        }

        main {
          font-size: 1rem;
        }

        .post-item {
          flex-direction: column;
          gap: 0.5rem;
        }

        .post-date {
          text-align: left;
        }

        .post-date .day {
          font-size: 2.25rem;
        }

        img {
          width: 100%;
        }

        pre code {
          white-space: pre-wrap;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }
      }
    </style>
    <link id="syntax-light" rel="stylesheet" href="https://cdn.jsdelivr.net/gh/jwarby/jekyll-pygments-themes@master/monokai.css">

  </head>

  <body>
    <header class="site-header">
      <div class="header-text">
        <a href="/" class="logo-link">
          <h1>{{ site.title }}</h1>
        </a>
        <p class="tagline">{{ site.description }}</p>
      </div>

      <button type="button" id="theme-toggle" class="theme-toggle" aria-label="Switch to dark mode" aria-pressed="false">🌙</button>
    </header>

    <script data-goatcounter="https://ronynn.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>

    <nav class="main-nav" aria-label="Primary">
      <a href="{{ '/' | relative_url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>Blog</a>
      <a href="{{ '/projects/' | relative_url }}" {% if page.url contains '/projects/' %}aria-current="page"{% endif %}>Projects</a>
      <a href="{{ '/tech-stack/' | relative_url }}" {% if page.url contains '/tech-stack/' %}aria-current="page"{% endif %}>Tech Stack</a>
      <a href="{{ '/about/' | relative_url }}" {% if page.url contains '/about/' %}aria-current="page"{% endif %}>About</a>
    </nav>

    <main id="main-content">
      {{ content }}
    </main>

    <footer class="site-footer">
      <p>&copy; {{ "now" | date: "%Y" }} • {{ site.title }}</p>
      <a href="{{ site.github.repository_url }}/blob/main/{{ page.path }}">Edit this page</a>
      <a href="https://twitter.com/intent/tweet?url={{ page.url | absolute_url }}&text={{ page.title | url_encode }}">Share on X</a>
    </footer>

    <script>
      (function () {
        var toggle = document.getElementById('theme-toggle');
        if (!toggle) return;

        function getTheme() {
          var explicit = document.documentElement.getAttribute('data-theme');
          if (explicit === 'dark' || explicit === 'light') return explicit;

          if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }

          return 'light';
        }

        function updateButton(theme) {
          var isDark = theme === 'dark';
          toggle.setAttribute('aria-pressed', String(isDark));
          toggle.setAttribute('aria-label', isDark ? 'Switch to light mode' : 'Switch to dark mode');
          toggle.textContent = isDark ? '☀️' : '🌙';
        }

        updateButton(getTheme());

        toggle.addEventListener('click', function () {
          var current = getTheme();
          var next = current === 'dark' ? 'light' : 'dark';

          document.documentElement.setAttribute('data-theme', next);

          try {
            localStorage.setItem('theme', next);
          } catch (e) {
          }

          updateButton(next);
        });

        window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
          try {
            if (localStorage.getItem('theme')) return;
          } catch (err) {
            return;
          }

          var next = e.matches ? 'dark' : 'light';
          document.documentElement.setAttribute('data-theme', next);
          updateButton(next);
        });
      })();
    </script>
  </body>
</html>