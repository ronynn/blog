<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ page.title | default: site.title }}</title>

  <style>
    /* Fallback variables (light theme) */
    :root {
      --accent: #6d28d9;
      --text-main: #111827;
      --text-muted: #4b5563;
      --bg-color: #ffffff;
      --border-color: #d1d5db;
      --code-bg: #f3f4f6;
      --code-text: #111827;
      --font-sans: monospace, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif;
      --font-mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    }

    /* System dark preference (when no manual override) */
    @media (prefers-color-scheme: dark) {
      :root {
        --accent: #a78bfa;
        --text-main: #f9fafb;
        --text-muted: #cbd5e1;
        --bg-color: #0f172a;
        --border-color: #334155;
        --code-bg: #1f2937;
        --code-text: #f9fafb;
      }
    }

    /* Reset and base */
    * { box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
    }

    body {
      margin: 0 auto;
      max-width: 850px;
      padding: 0 1.5rem;
      background: var(--bg-color);
      color: var(--text-main);
      font-family: var(--font-sans);
      line-height: 1.6;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
      overflow-wrap: break-word;
      transition: background-color 0.2s ease, color 0.2s ease;
      min-height: 100vh;
    }

    /* Hide radio buttons visually but keep them focusable */
    .theme-radio {
      position: absolute;
      opacity: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    /* Wrapper – will hold override variables */
    #page-wrapper {
      background: var(--bg-color);
      color: var(--text-main);
      min-height: 100vh;
    }

    /* Light theme override when #light-radio is checked */
    #light-radio:checked ~ #page-wrapper {
      --accent: #6d28d9;
      --text-main: #111827;
      --text-muted: #4b5563;
      --bg-color: #ffffff;
      --border-color: #d1d5db;
      --code-bg: #f3f4f6;
      --code-text: #111827;
      color-scheme: light;
    }

    /* Dark theme override when #dark-radio is checked */
    #dark-radio:checked ~ #page-wrapper {
      --accent: #a78bfa;
      --text-main: #f9fafb;
      --text-muted: #cbd5e1;
      --bg-color: #0f172a;
      --border-color: #334155;
      --code-bg: #1f2937;
      --code-text: #f9fafb;
      color-scheme: dark;
    }

    /* Theme toggle labels */
    .theme-toggle-group {
      display: inline-flex;
      gap: 0.5rem;
      flex-shrink: 0;
    }

    .theme-toggle-label {
      cursor: pointer;
      background: transparent;
      border: 1px solid var(--border-color);
      color: var(--text-main);
      border-radius: 999px;
      padding: 0.5rem 0.8rem;
      font-size: 0.95rem;
      line-height: 1;
      user-select: none;
      transition: border-color 0.2s, color 0.2s, background-color 0.2s;
    }

    .theme-toggle-label:hover {
      border-color: var(--accent);
      color: var(--accent);
    }

    /* Active state for the label associated with the checked radio */
    #light-radio:checked ~ #page-wrapper label[for="light-radio"],
    #dark-radio:checked ~ #page-wrapper label[for="dark-radio"] {
      background: var(--accent);
      color: #fff;
      border-color: var(--accent);
    }

    /* Header */
    header.site-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: 4rem 0 1rem 0;
    }

    .header-text {
      min-width: 0;
    }

    .logo-link {
      text-decoration: none;
      color: var(--text-main);
      transition: opacity 0.2s;
    }

    .logo-link:hover { opacity: 0.7; }

    header h1 {
      font-size: 2.5rem;
      font-weight: 800;
      margin: 0;
      letter-spacing: -0.02em;
      line-height: 1.2;
    }

    .tagline {
      font-size: 1.1rem;
      color: var(--text-muted);
      margin: 0.5rem 0 0 0;
    }

    /* Navigation */
    nav.main-nav {
      margin: 2rem 0 4rem 0;
      display: flex;
      gap: 2rem;
      border-bottom: 1px solid var(--border-color);
      padding-bottom: 1rem;
      overflow-x: auto;
    }

    nav.main-nav a {
      text-decoration: none;
      color: var(--text-main);
      font-weight: 600;
      font-size: 1rem;
      padding: 0.5rem 0;
      white-space: nowrap;
    }

    nav.main-nav a:hover { color: var(--accent); }

    nav.main-nav a[aria-current="page"] {
      color: var(--accent);
    }

    /* Content */
    main {
      font-size: 1rem;
    }

    h2, h3, h4 {
      color: var(--text-main);
      margin-top: 2.5rem;
      font-weight: 800;
      line-height: 1.3;
    }

    a {
      color: var(--accent);
      text-decoration: none;
    }

    a:hover { text-decoration: underline; }

    .logo-link,
    nav.main-nav a {
      text-decoration: none;
    }

    :focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    /* Post list */
    .posts-list { list-style: none; padding: 0; }

    .post-item {
      display: flex;
      gap: 3rem;
      margin-bottom: 3.5rem;
    }

    .post-date .day {
      font-size: 3rem;
      font-weight: 800;
      display: block;
      line-height: 0.9;
      color: gray;
    }

    .post-date .month-year {
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: uppercase;
      color: var(--text-muted);
      display: block;
      margin-top: 0.2rem;
    }

    .post-info h3 {
      margin: 0;
      font-size: 1.5rem;
      line-height: 1.2;
    }

    .post-info p {
      margin: 0.5rem 0 0 0;
      color: var(--text-muted);
      font-size: 1rem;
    }

    /* Images */
    img {
      width: 75%;
      display: block;
      margin-left: auto;
      margin-right: auto;
      height: auto;
      max-width: 100%;
    }

    /* Code */
    code, pre {
      box-sizing: border-box;
      overflow-x: hidden;
      word-wrap: break-word;
      white-space: pre-wrap;
      overflow-wrap: break-word;
      background-color: var(--code-bg);
      color: var(--code-text);
      padding: 0.2em 0.4em;
      border-radius: 3px;
      font-family: var(--font-mono);
    }

    pre {
      padding: 1rem;
    }

    pre code {
      padding: 0;
      background: transparent;
      white-space: pre-wrap;
    }

    /* Footer */
    footer.site-footer {
      margin: 6rem 0 3rem 0;
      color: var(--text-muted);
      font-size: 0.9rem;
    }

    /* Mobile */
    @media (max-width: 600px) {
      body {
        padding: 0 1rem;
      }

      header.site-header {
        flex-direction: column;
      }

      header h1 {
        font-size: 1.8rem;
      }

      nav.main-nav {
        gap: 1rem;
      }

      .post-item {
        flex-direction: column;
        gap: 0.5rem;
      }

      .post-date {
        text-align: left;
      }

      .post-date .day {
        font-size: 2.25rem;
      }

      img {
        width: 100%;
      }
    }

    /* Reduced motion */
    @media (prefers-reduced-motion: reduce) {
      html {
        scroll-behavior: auto;
      }

      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>

<body>
  <!-- Theme radio buttons (hidden) -->
  <input type="radio" name="theme" id="light-radio" class="theme-radio" checked>
  <input type="radio" name="theme" id="dark-radio" class="theme-radio">

  <div id="page-wrapper">
    <header class="site-header">
      <div class="header-text">
        <a href="/" class="logo-link">
          <h1>{{ site.title }}</h1>
        </a>
        <p class="tagline">{{ site.description }}</p>
      </div>

      <div class="theme-toggle-group" role="group" aria-label="Theme switcher">
        <label for="light-radio" class="theme-toggle-label">☀️</label>
        <label for="dark-radio" class="theme-toggle-label">🌙</label>
      </div>
    </header>

    <script data-goatcounter="https://ronynn.goatcounter.com/count"
        async src="//gc.zgo.at/count.js"></script>

    <nav class="main-nav" aria-label="Primary">
      <a href="{{ '/' | relative_url }}" {% if page.url == '/' %}aria-current="page"{% endif %}>Blog</a>
      <a href="{{ '/projects/' | relative_url }}" {% if page.url contains '/projects/' %}aria-current="page"{% endif %}>Projects</a>
      <a href="{{ '/tech-stack/' | relative_url }}" {% if page.url contains '/tech-stack/' %}aria-current="page"{% endif %}>Tech Stack</a>
      <a href="{{ '/about/' | relative_url }}" {% if page.url contains '/about/' %}aria-current="page"{% endif %}>About</a>
    </nav>

    <main id="main-content">
      {{ content }}
    </main>

    <footer class="site-footer">
      <p>&copy; {{ "now" | date: "%Y" }} • {{ site.title }}</p>
    </footer>
  </div>
</body>
</html>